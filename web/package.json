{
  "name": "onepiece-tracker",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "build:fn": "esbuild supabase/functions/game/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=supabase/functions/game/dist/index.js",
    "build:fn:dm": "esbuild supabase/functions/dm/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=supabase/functions/dm/dist/index.js",
    "build:engine": "esbuild lib/engine/server.ts --bundle --format=iife --global-name=OPServer --platform=neutral --target=es2022 --minify --outfile=public/engine/server.js",
    "prebuild": "npm run build:engine",
    "build:cards": "esbuild scripts/build-cards.ts --bundle --platform=node --format=esm --outfile=.cards-build.mjs --log-level=warning && node .cards-build.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": "22.x"
  }
}
